config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi'
	option band '5g'
	option channel 'auto'
	option htmode 'HE80'
	option country 'BR'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'HomeNet'
	option encryption 'psk2'
	option disabled '0'
	option key 'REDACTED'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi+1'
	option band '2g'
	option channel 'auto'
	option htmode 'HE20'
	option country 'BR'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'HomeNet'
	option encryption 'psk2'
	option disabled '0'
	option key 'REDACTED'

config wifi-iface 'sta_uplink'
	option device 'radio0'
	option mode 'sta'
	option ssid 'HomeNet'
	option encryption 'psk2'
	option key 'REDACTED'
	option network 'wwan'
	option disabled '0'
	# BSSID do AP principal (opcional; fixa o rádio/canal do uplink)
	option bssid 'AA:BB:CC:DD:EE:FF'
