#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
start_service() {
	procd_open_instance guard
	procd_set_param command /usr/local/bin/guard.sh
	procd_set_param respawn 3600 5 5
	procd_close_instance
	procd_open_instance bait
	procd_set_param command /usr/local/bin/bait.sh
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
