From 63c6efff99039745dafd08305c9eab52090af9a1 Mon Sep 17 00:00:00 2001
From: Diego Macario <diego_macario@hotmail.com>
Date: Sat, 17 Oct 2026 07:54:03 -0300
Subject: [PATCH] ipq60xx: add Xiaomi Redmi AX1800 (RM1800) support

- DTS ipq6000-xiaomi-ax1800 (NAND, dual boot slots)
- ipq-wifi board-2 BDF (board-xiaomi_ax1800.ipq6018)
- caldata: extract ART from 0:ART offset 0x1000 len 0x10000 (64 KB)
- uboot-envtools: APPSBLENV; bootcount: confirm A/B boot flags
- platform.sh: NAND upgrade to alternate rootfs slot
- board.d: lan1-3 + wan mapping
---
 .../uboot-envtools/files/qualcommax_ipq60xx   |   3 +
 package/firmware/ipq-wifi/Makefile            |   4 +-
 .../files/board-xiaomi_ax1800.ipq6018         | Bin 0 -> 65640 bytes
 .../boot/dts/qcom/ipq6000-xiaomi-ax1800.dts   | 337 ++++++++++++++++++
 target/linux/qualcommax/image/ipq60xx.mk      |  15 +
 .../ipq60xx/base-files/etc/board.d/02_network |   3 +
 .../etc/hotplug.d/firmware/11-ath11k-caldata  |   4 +
 .../ipq60xx/base-files/etc/init.d/bootcount   |  43 +++
 .../base-files/lib/upgrade/platform.sh        |  36 ++
 9 files changed, 444 insertions(+), 1 deletion(-)
 create mode 100644 package/firmware/ipq-wifi/files/board-xiaomi_ax1800.ipq6018
 create mode 100644 target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6000-xiaomi-ax1800.dts

diff --git a/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq60xx b/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq60xx
index a06ffc1..352fd3b 100644
--- a/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq60xx
+++ b/package/boot/uboot-tools/uboot-envtools/files/qualcommax_ipq60xx
@@ -30,6 +30,9 @@ tplink,eap625-outdoor-hd-v1)
 yuncore,fap650)
 	ubootenv_add_mtd "0:appsblenv" "0x0" "0x10000" "0x10000"
 	;;
+xiaomi,ax1800)
+	ubootenv_add_mtd "0:APPSBLENV" "0x0" "0x10000" "0x20000"
+	;;
 esac
 
 config_load ubootenv
diff --git a/package/firmware/ipq-wifi/Makefile b/package/firmware/ipq-wifi/Makefile
index d447eef..f2a0dea 100644
--- a/package/firmware/ipq-wifi/Makefile
+++ b/package/firmware/ipq-wifi/Makefile
@@ -91,6 +91,7 @@ ALLWIFIBOARDS:= \
 	tplink_tl-wa1201-v2 \
 	wallys_dr40x9 \
 	xiaomi_aiot-ac2350 \
+	xiaomi_ax1800 \
 	xiaomi_ax3600 \
 	xiaomi_ax6000 \
 	xiaomi_ax9000 \
@@ -185,7 +186,7 @@ Do not install it for any other device!
   endef
 
   define Package/ipq-wifi-$(1)/install-overlay
-    $$$$(foreach IPQ_WIFI_BOARD_FILE,$$$$(wildcard $(PKG_BUILD_DIR)/board-$(1).*),\
+    $$$$(foreach IPQ_WIFI_BOARD_FILE,$$$$(wildcard $(PKG_BUILD_DIR)/board-$(1).* $(CURDIR)/files/board-$(1).*),\
       $$$$(call ipq-wifi-install-one,$$$$(IPQ_WIFI_BOARD_FILE),$$(1)))
   endef
 
@@ -274,6 +275,7 @@ $(eval $(call generate-ipq-wifi-package,tplink_archer-c60-v2,TP-Link Archer C60
 $(eval $(call generate-ipq-wifi-package,tplink_tl-wa1201-v2,TP-Link TL-WA1201 V2))
 $(eval $(call generate-ipq-wifi-package,wallys_dr40x9,Wallys DR40X9))
 $(eval $(call generate-ipq-wifi-package,xiaomi_aiot-ac2350,Xiaomi AIoT AC2350))
+$(eval $(call generate-ipq-wifi-package,xiaomi_ax1800,Xiaomi Redmi AX1800))
 $(eval $(call generate-ipq-wifi-package,xiaomi_ax3600,Xiaomi AX3600))
 $(eval $(call generate-ipq-wifi-package,xiaomi_ax6000,Xiaomi AX6000))
 $(eval $(call generate-ipq-wifi-package,xiaomi_ax9000,Xiaomi AX9000))
