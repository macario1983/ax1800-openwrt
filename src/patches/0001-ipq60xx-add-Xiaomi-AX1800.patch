diff --git a/target/linux/qualcommax/ipq60xx/base-files/etc/init.d/bootcount b/target/linux/qualcommax/ipq60xx/base-files/etc/init.d/bootcount
index 5490e65..fd03d9d 100755
--- a/target/linux/qualcommax/ipq60xx/base-files/etc/init.d/bootcount
+++ b/target/linux/qualcommax/ipq60xx/base-files/etc/init.d/bootcount
@@ -15,5 +15,48 @@ boot() {
 	netgear,wax610y)
 		fw_setenv boot_count 0
 	;;
+	xiaomi,ax1800)
+		local cur_boot_part
+		local args
+		local mtd_idx
+
+		# /etc/fw_env.config is only generated on the first boot
+		# (30_uboot-envtools); make sure it is available so that the
+		# boot confirmation below actually reaches the bootloader
+		mtd_idx="$(find_mtd_index 0:APPSBLENV)"
+		[ -n "$mtd_idx" ] &&
+			! grep -qs "^/dev/mtd$mtd_idx " /etc/fw_env.config &&
+			echo "/dev/mtd$mtd_idx 0x0 0x10000 0x20000" > /etc/fw_env.config
+
+		# Find out which rootfs slot u-boot booted us from
+		read -r args < /proc/cmdline
+		for arg in $args; do
+			case "${arg#ubi.mtd=}" in
+			rootfs)
+				cur_boot_part=0
+				;;
+			rootfs_1)
+				cur_boot_part=1
+				;;
+			esac
+		done
+
+		# Not booted from NAND (e.g. initramfs), nothing to confirm
+		[ -n "$cur_boot_part" ] || return 0
+
+		# Confirm the boot and keep the bootloader's slot flags in sync,
+		# otherwise u-boot considers the boot failed and eventually falls
+		# back to the other rootfs slot
+		fw_setenv -s - <<-EOF
+			flag_boot_rootfs $cur_boot_part
+			flag_boot_success 1
+			flag_last_success $cur_boot_part
+			flag_ota_reboot 0
+			flag_try_sys1_failed 0
+			flag_try_sys2_failed 0
+		EOF
+
+		logger -t bootcount "confirmed boot from rootfs slot $cur_boot_part"
+	;;
 	esac
 }
